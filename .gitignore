# Obsidian
.obsidian/workspace*
.obsidian/cache/
.obsidian/plugins/
.obsidian/community-plugins.json

# Trash
.trash/
*.tmp

# OS Files
.DS_Store
Thumbs.db

# ─── Personal data files — NEVER commit ─────────────────────────────────────
# Org chart, contact lists, or any data file containing people information.
# Use scripts/generate_people.py --data <path> to point to these files locally.
data/

# ─── Secrets and auth tokens — NEVER commit ──────────────────────────────────
.env
.auth/
*.token
*credentials*.json

# ─── Knowledge graph — never committed ───────────────────────────────────────
# Both files will reference or contain proprietary data after day-one ingest.
# Rebuild on a new machine with: python3 scripts/ingest.py 04-knowledge/ --batch --yes
graph/graph.json
graph/ingest_manifest.json
graph/drive-sync-state.json

# Python virtual environment
.venv/
__pycache__/
*.pyc

# ─── Identity files — personal, stay local only ──────────────────────────────
# Create these on each machine from templates/identity/ via setup.sh
SOUL.md
USER.md
MEMORY.md
OPEN_LOOPS.md
INGEST_QUEUE.md

# ─── Vault content — all personal, never committed ───────────────────────────
# Framework (skills, agents, hooks, templates) IS committed.
# Content (notes, logs, knowledge, people, projects) is NOT.

# 00-inbox personal config (create from templates/identity/ via setup.sh)
00-inbox/MY-PROFILE.md
00-inbox/MY-INTERESTS.md
00-inbox/MY-INTEGRATIONS.md
00-inbox/drive-sync.json
00-inbox/ingest-scan.json

# Daily notes
01-daily/briefs/*.md
01-daily/checkins/*.md
01-daily/weekly/*.md


# People CRM
02-people/*.md
!02-people/README.md

# Projects
03-projects/**
!03-projects/.gitkeep

# Knowledge base — all content (md, csv, txt, docx, xlsx, pdf, etc.)
04-knowledge/**
!04-knowledge/**/.gitkeep

# Decisions, mistakes, resources
05-decisions/*.md
06-mistakes/*.md
07-resources/*.md

# AI agent outputs (keep directory structure via .gitkeep, ignore content)
# Use ** to match any depth of subdirectories (e.g. AI/research/sage-interviews/)
AI/sessions/**
AI/research/**
AI/evaluations/**
AI/drafts/**
!AI/**/.gitkeep

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log

# ─── Backup files ────────────────────────────────────────────────────────────
*.bak
*~
*.backup.*

# Submission and marketplace tracking
.github/SUBMISSION-CHECKLIST.md
.github/SUBMISSION-TEMPLATES.md
.github/MARKETPLACE.md
COG-BACKLOG.md
COG-IMPLEMENTATION-PLAN.md
