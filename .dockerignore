01-daily/
02-people/
03-projects/
04-knowledge/
05-decisions/
06-mistakes/
07-resources/
AI/
graph/
templates/
docs/

# Obsidian state
.obsidian/
.trash/

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
