# Copy this to .env and fill in your values.
# .env is gitignored — never commit the real file.

# Anthropic
ANTHROPIC_API_KEY=

# Google OAuth (Calendar + Gmail — configure in Google Cloud Console)
# See setup.sh section 6 for step-by-step instructions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=.auth/google-token.json

# Your email addresses
PERSONAL_EMAIL=
WORK_EMAIL=                   # fill when work account is provisioned on day one

# GitHub
GITHUB_USER=

# Slack (user token — xoxp-..., not a bot token)
# Create app at https://api.slack.com/apps → OAuth & Permissions → User Token Scopes:
#   channels:history, channels:read, im:history, users:read, search:read
# Install app → copy "User OAuth Token" (starts with xoxp-)
SLACK_BOT_TOKEN=

# Future integrations (uncomment when needed)
# SLACK_WORKSPACE=
# NOTION_TOKEN=
# ASANA_TOKEN=
