# Copy this to .env and fill in your values.
# .env is gitignored — never commit the real file.

# Anthropic
ANTHROPIC_API_KEY=

# Google OAuth (Calendar + Gmail — configure in Google Cloud Console)
# See setup.sh section 6 for step-by-step instructions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=.auth/google-token.json

# Your email addresses
PERSONAL_EMAIL=
WORK_EMAIL=                   # fill when work account is provisioned on day one

# GitHub
GITHUB_USER=

# Slack (user token — xoxp-..., not a bot token)
# Create app at https://api.slack.com/apps → OAuth & Permissions → User Token Scopes:
#   channels:history, channels:read, im:history, mpim:history, groups:history,
#   users:read, search:read
# Install app → copy "User OAuth Token" (starts with xoxp-)
SLACK_BOT_TOKEN=
# Comma-separated Slack channel IDs to include in digest (e.g. C12345,C67890)
# Find channel ID: right-click channel in Slack → View channel details → bottom of About tab
SLACK_WATCH_CHANNELS=

# Notion (Internal Integration token — create at https://www.notion.so/my-integrations)
# Token starts with secret_ntn_... — share each page/DB with the integration in Notion UI
NOTION_TOKEN=

# Palantir Foundry
# Token: Foundry → Profile → User Settings → API Keys → New Token
# Host: base URL of your Foundry instance (e.g. https://your-instance.palantirfoundry.com)
FOUNDRY_TOKEN=
FOUNDRY_HOST=

# Vault owner identity — used by scripts to skip self in CRM generation and
# to resolve email domains to org names. Never hardcode these in scripts.
VAULT_OWNER_NAME=
VAULT_OWNER_START_DATE=          # YYYY-MM-DD — your org start date
# JSON map of email domain → org name. Include your employer and any key vendors.
# Example: {"yourcompany.com":"Acme Corp","vendor.com":"Vendor Inc"}
VAULT_DOMAIN_ORG_MAP={}
# Your employer/home org — people at this org are tagged internal in the CRM.
# Leave blank to tag everyone "external". Example: VAULT_HOME_ORG=Acme Corp
VAULT_HOME_ORG=
# Tag applied to home-org people (default "internal"). Example: VAULT_HOME_ORG_TAG=internal
VAULT_HOME_ORG_TAG=

# Future integrations (uncomment when needed)
# SLACK_WORKSPACE=
# ASANA_TOKEN=
